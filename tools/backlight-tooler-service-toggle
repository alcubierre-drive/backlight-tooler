#!/bin/bash

# Small script for toggling the daemon, use for keybindings

title="Automatic Backlight Control"
runstring="started"
stopstring="stopped"

status_before="$(systemctl --user is-active backlight-tooler.service)"

if [ $? -eq 0 ]; then
    systemctl --user stop backlight-tooler.service
    notify-send "$title" "$stopstring"
else
    systemctl --user start backlight-tooler.service
    notify-send "$title" "$runstring"
fi

status_after="$(systemctl --user is-active backlight-tooler.service)"

echo "changing from ${status_before} to ${status_after}"
